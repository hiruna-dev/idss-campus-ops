# MongoDB connection (master_context_file.md Section 2.3 / Section 5)
# Copy this file to .env and adjust values. .env is gitignored.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGO_DATABASE=idss

# Optional: override the data root used by JsonLoader / DatabaseSeeder.
# Defaults to the project root (parent of the module that calls it).
DATA_DIR=data
